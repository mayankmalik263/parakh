# BharatCode API (OpenAI-compatible): https://bharatcode.ai. Eligible students get free access, subject to current usage limits.
BHARATCODE_API_KEY=your_bharatcode_api_key_here
# BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
# Model for every agent. The student tier serves qwen-3.8-27b.
PARAKH_MODEL=qwen-3.8-27b
# Optional: a different model for the Critic (e.g. a Pro-tier model), so it doesn't grade its own model.
# PARAKH_CRITIC_MODEL=
# Optional: a separate model for reading pitch-deck images. Defaults to PARAKH_MODEL.
# PARAKH_VISION_MODEL=
# Seconds to wait for one model reply before giving up.
# BHARATCODE_TIMEOUT_S=180
# Set to 0 if BharatCode rejects response_format={"type": "json_object"}.
# BHARATCODE_JSON_MODE=1
# Seconds a run may take before a second revision round is skipped. Re-measure on BharatCode.
# PARAKH_SECOND_ROUND_BUDGET_S=100

ALLOWED_ORIGINS=http://localhost:3000

SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_role_key

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Dev Tools
NEXT_PUBLIC_ENABLE_DEV_TOOLS=false
